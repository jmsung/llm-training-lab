# Environment / secrets
.env
.env.local

# Python
__pycache__/
*.pyc
.venv/
dist/
*.egg-info/
.ipynb_checkpoints/

# Knowledge layer — the .md cards ARE tracked, including any raw/ this repo
# produces from its OWN ingests. Note the corpus fan-out is source-only since
# 2026-08-03, so synced raw/ does not arrive from knowledge-base. knowledge/
# holds ONLY distilled .md cards; native binaries (PDF/CIF/SDF/PDB) NEVER belong in
# knowledge/ (raw files → data/ (deposited) or results/ (generated)). Ignore any that
# land here as a safety net — the knowledge-shape-lint flags them.
knowledge/**/*.pdf
knowledge/**/*.cif
knowledge/**/*.sdf
knowledge/**/*.pdb

# Appended by /project-start when those dirs are chosen
# (contents ignored, role-describing README tracked):
# data/*
# !data/README.md
# results/*
# !results/README.md
# data/ holds deposited/reference raw files (e.g. data/structures/*.cif — the .md
# card lives in knowledge/entities/structures/); results/ holds generated outputs.

results/*
!results/README.md
